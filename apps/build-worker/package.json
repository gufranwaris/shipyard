    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.5",
    "pg": "^8.21.0",
    "simple-git": "^3.36.0"
  }
